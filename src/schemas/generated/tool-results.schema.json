            "required": [
              "p95LatencyMs",
              "errorRatePercent",
              "affectedSessions",
              "abandonedCheckouts",
              "syntheticRevenueAtRiskUsd"
            ],
            "additionalProperties": false
          },
          "services": {
            "allOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "const": "edge"
                  },
                  {
                    "type": "string",
                    "const": "checkout-api"
                  },
                  {
                    "type": "string",
                    "const": "pricing"
                  },
                  {
                    "type": "string",
                    "const": "payments"
                  },
                  {
                    "type": "string",
                    "const": "orders-db"
                  }
                ]
              },
              {
                "minItems": 5,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "edge",
                    "checkout-api",
                    "pricing",
                    "payments",
                    "orders-db"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "impact",
          "services"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "ok",
      "receiptId",
      "state",
      "summary",
      "data"
    ],
    "additionalProperties": false
  },

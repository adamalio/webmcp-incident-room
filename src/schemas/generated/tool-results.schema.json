    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      },
      "receiptId": {
        "type": "string",
        "const": "ins_001"
      },
      "state": {
        "type": "string",
        "const": "investigating"
      },
      "summary": {
        "type": "string",
        "const": "Synthetic checkout impact is active across checkout-api and pricing."
      },
      "data": {
        "type": "object",

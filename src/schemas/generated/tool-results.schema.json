          "impact": {
            "type": "object",
            "properties": {
              "p95LatencyMs": {
                "type": "number",
                "const": 4820
              },
              "errorRatePercent": {
                "type": "number",
                "const": 8.4
              },
              "affectedSessions": {
                "type": "number",
                "const": 1284
              },
              "abandonedCheckouts": {
                "type": "number",
                "const": 312
